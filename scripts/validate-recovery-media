#!/usr/bin/bash
set -euo pipefail

[[ -d /sys/firmware/efi/efivars ]] || {
    echo 'Recovery requires the installer to boot in UEFI mode.' >&2
    exit 1
}
# The Fedora-signed ISO and the recovery path use Fedora's signed shim/GRUB
# chain. Secure Boot must not block starting Calamares.

# Each slot is limited to 14 GiB, leaving room for two bundles and ext4 reserve.
maximum_bundle_bytes=$((14 * 1024 * 1024 * 1024))

find_live_media_root() {
    local candidate
    local -a candidates=(/run/initramfs/live /run/install/repo)

    while IFS= read -r candidate; do
        candidates+=("$candidate")
    done < <(/usr/bin/findmnt --raw --noheadings --output TARGET)

    for candidate in "${candidates[@]}"; do
        if [[ -s "$candidate/LiveOS/squashfs.img" && \
              -s "$candidate/images/pxeboot/vmlinuz" && \
              -s "$candidate/images/pxeboot/initrd.img" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

live_media_root=$(find_live_media_root) || {
    echo 'Recovery media check failed: live kernel, initramfs, or squashfs image was not found.' >&2
    exit 1
}

[[ -s /usr/share/cubelinux/payload.oci.tar ]] || {
    echo 'Recovery media check failed: embedded offline OCI payload is missing.' >&2
    exit 1
}
[[ -s /usr/share/cubelinux/target-image-ref ]] || {
    echo 'Recovery media check failed: target image reference is missing.' >&2
    exit 1
}

bundle_bytes=0
for source in \
    "$live_media_root/LiveOS/squashfs.img" \
    "$live_media_root/images/pxeboot/vmlinuz" \
    "$live_media_root/images/pxeboot/initrd.img"; do
    bytes=$(/usr/bin/stat --format=%s -- "$source")
    bundle_bytes=$((bundle_bytes + bytes))
done

(( bundle_bytes <= maximum_bundle_bytes )) || {
    echo "Recovery bundle exceeds the 14 GiB slot limit (bundle: ${bundle_bytes} bytes; maximum: ${maximum_bundle_bytes})." >&2
    exit 1
}

echo "Recovery media fits the 32 GiB partition's two-slot layout (${bundle_bytes} bytes per bundle)."
