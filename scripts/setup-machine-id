#!/usr/bin/bash
set -euo pipefail

target_root=${1:?Usage: setup-machine-id ROOT_PATH}
target_root=$(realpath -e -- "$target_root")

if [[ ! -d "$target_root/etc" ]]; then
    echo "The target root has no /etc directory: $target_root" >&2
    exit 1
fi

/usr/bin/systemd-machine-id-setup --root="$target_root"
/usr/bin/mkdir -p "$target_root/var/lib/dbus"
/usr/bin/ln -sf /etc/machine-id "$target_root/var/lib/dbus/machine-id"
