#!/usr/bin/bash
set -euo pipefail

target_root=${1:?Usage: stage-recovery ROOT_PATH}
target_root=$(/usr/bin/realpath -e -- "$target_root")
recovery_label=CUBE_RECOVERY
root_label=CUBE_ROOT
recovery_mount=/run/cubelinux-recovery-staging
minimum_free_bytes=1073741824

fail() {
    echo "Recovery staging failed: $*" >&2
    exit 1
}

find_live_media_root() {
    local candidate
    local -a candidates=(/run/initramfs/live /run/install/repo)

    while IFS= read -r candidate; do
        candidates+=("$candidate")
    done < <(/usr/bin/findmnt --raw --noheadings --output TARGET)

    for candidate in "${candidates[@]}"; do
        if [[ -s "$candidate/LiveOS/squashfs.img" && \
              -s "$candidate/images/pxeboot/vmlinuz" && \
              -s "$candidate/images/pxeboot/initrd.img" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

find_parent_disk() {
    local device=${1:?Block device is required}
    /usr/bin/lsblk --inverse --list --noheadings --paths --output NAME,TYPE -- "$device" |
        /usr/bin/awk '$2 == "disk" { print $1; exit }'
}

find_parent_partition() {
    local device=${1:?Block device is required}
    /usr/bin/lsblk --inverse --list --noheadings --paths --output NAME,TYPE -- "$device" |
        /usr/bin/awk '$2 == "part" { print $1; exit }'
}

partition_span() {
    local device=${1:?Block device is required}
    local start sectors
    start=$(/usr/bin/lsblk --nodeps --noheadings --output START -- "$device" | /usr/bin/tr -d '[:space:]')
    sectors=$(/usr/sbin/blockdev --getsz "$device")
    printf '%s %s\n' "$start" "$sectors"
}

/usr/bin/udevadm settle --timeout=30 || fail 'partition discovery did not settle'
root_device=$(/usr/bin/findmnt --noheadings --raw --output SOURCE --mountpoint "$target_root") ||
    fail "Calamares did not mount the target root at $target_root"
root_device=${root_device%%\[*}
[[ -b "$root_device" ]] || fail "target root source is not a block device: $root_device"
root_disk=$(find_parent_disk "$root_device")
[[ -n "$root_disk" ]] || fail "could not identify the target disk for $root_device"
root_partition=$(find_parent_partition "$root_device")
[[ -n "$root_partition" ]] || fail "could not identify the target root partition for $root_device"

mapfile -t recovery_candidates < <(/usr/sbin/blkid --match-token "PARTLABEL=$recovery_label" --output device || true)
matching_recovery_devices=()
for candidate in "${recovery_candidates[@]}"; do
    [[ -b "$candidate" ]] || continue
    candidate_disk=$(find_parent_disk "$candidate")
    [[ "$candidate_disk" == "$root_disk" ]] || continue

    read -r candidate_start candidate_sectors < <(partition_span "$candidate")
    read -r root_start root_sectors < <(partition_span "$root_partition")
    [[ "$candidate_start" =~ ^[0-9]+$ && "$candidate_sectors" =~ ^[0-9]+$ && \
       "$root_start" =~ ^[0-9]+$ && "$root_sectors" =~ ^[0-9]+$ ]] || continue

    candidate_end=$((candidate_start + candidate_sectors))
    root_end=$((root_start + root_sectors))
    # Calamares places the recovery and root entries next to each other. Allow
    # up to 2 MiB for alignment while distinguishing an older recovery slot.
    if (( (candidate_end <= root_start && root_start - candidate_end <= 4096) || \
          (root_end <= candidate_start && candidate_start - root_end <= 4096) )); then
        matching_recovery_devices+=("$candidate")
    fi
done

(( ${#matching_recovery_devices[@]} == 1 )) ||
    fail "expected one $recovery_label partition on $root_disk; found ${#matching_recovery_devices[@]}"
recovery_device=${matching_recovery_devices[0]}

root_part_label=$(/usr/sbin/blkid --noheadings --output value --match-tag PARTLABEL -- "$root_partition" || true)
[[ "$root_part_label" == "$root_label" ]] ||
    fail "target root partition must have GPT label $root_label; found '${root_part_label:-none}'"

recovery_fs_type=$(/usr/sbin/blkid --noheadings --output value --match-tag TYPE -- "$recovery_device" || true)
[[ "$recovery_fs_type" == ext4 ]] ||
    fail "$recovery_label must be ext4; found '${recovery_fs_type:-unknown}'"

root_partuuid=$(/usr/sbin/blkid --noheadings --output value --match-tag PARTUUID -- "$root_partition" || true)
recovery_partuuid=$(/usr/sbin/blkid --noheadings --output value --match-tag PARTUUID -- "$recovery_device" || true)
disk_ptuuid=$(/usr/sbin/blkid --noheadings --output value --match-tag PTUUID -- "$root_disk" || true)
efi_device=$(/usr/bin/findmnt --noheadings --raw --output SOURCE --mountpoint "$target_root/boot/efi" || true)
efi_device=${efi_device%%\[*}
[[ -b "$efi_device" ]] || fail 'the target EFI system partition is not mounted'
efi_partition=$(find_parent_partition "$efi_device")
[[ -n "$efi_partition" && "$(find_parent_disk "$efi_partition")" == "$root_disk" ]] ||
    fail 'the EFI system partition must be on the same disk as the target root'
efi_partuuid=$(/usr/sbin/blkid --noheadings --output value --match-tag PARTUUID -- "$efi_partition" || true)
[[ -n "$root_partuuid" && -n "$recovery_partuuid" && -n "$disk_ptuuid" && -n "$efi_partuuid" ]] ||
    fail 'could not record stable GPT identities for the recovery layout'

live_media_root=$(find_live_media_root) ||
    fail 'could not locate the live ISO kernel, initramfs, and squashfs image'
[[ -s /usr/share/cubelinux/payload.oci.tar ]] ||
    fail 'the live installer does not contain the offline OCI payload'
[[ -s /usr/share/cubelinux/target-image-ref ]] ||
    fail 'the live installer does not contain its target image reference'
[[ -x /usr/lib/cubelinux-recovery/recovery-ui && \
   ! -L /usr/lib/cubelinux-recovery/recovery-ui && \
   -d /usr/lib/cubelinux-recovery/qml && \
   -d /usr/lib/cubelinux-recovery/runtime ]] ||
    fail 'the live installer does not contain the recovery runtime component'
for required in \
    /usr/lib/cubelinux-recovery/qml/Main.qml \
    /usr/lib/cubelinux-recovery/qml/InstallerError.qml \
    /usr/lib/cubelinux-recovery/runtime/check-recovery-layout \
    /usr/lib/cubelinux-recovery/runtime/cleanup-installed-fstab \
    /usr/lib/cubelinux-recovery/runtime/factory-reset \
    /usr/lib/cubelinux-recovery/runtime/install-bootc \
    /usr/lib/cubelinux-recovery/runtime/install-recovery-boot \
    /usr/lib/cubelinux-recovery/runtime/verify-recovery-bundle; do
    [[ -f "$required" && ! -L "$required" ]] ||
        fail "recovery runtime component is missing or unsafe: $required"
done

/usr/bin/install -d -m 0755 "$recovery_mount"
if /usr/bin/mountpoint --quiet "$recovery_mount"; then
    fail "$recovery_mount is already mounted"
fi
/usr/bin/mount --types ext4 --options nodev,nosuid,noexec "$recovery_device" "$recovery_mount"
recovery_mounted=1
cleanup() {
    if (( recovery_mounted )); then
        /usr/bin/umount "$recovery_mount" || true
    fi
}
trap cleanup EXIT

shopt -s dotglob nullglob
for item in "$recovery_mount"/*; do
    [[ "${item##*/}" == lost+found ]] && continue
    [[ ! -e "$item" ]] || fail "recovery partition is not empty: $item"
done
shopt -u dotglob nullglob

bundle_bytes=0
for source in \
    "$live_media_root/LiveOS/squashfs.img" \
    "$live_media_root/images/pxeboot/vmlinuz" \
    "$live_media_root/images/pxeboot/initrd.img"; do
    bytes=$(/usr/bin/stat --format=%s -- "$source")
    bundle_bytes=$((bundle_bytes + bytes))
done
maximum_bundle_bytes=$((14 * 1024 * 1024 * 1024))
(( bundle_bytes <= maximum_bundle_bytes )) ||
    fail "offline recovery image exceeds the 14 GiB limit (${bundle_bytes} bytes)"
available_bytes=$(/usr/bin/df --block-size=1 --output=avail -- "$recovery_mount" |
    /usr/bin/tail -n 1 | /usr/bin/tr -d '[:space:]')
[[ "$available_bytes" =~ ^[0-9]+$ ]] || fail 'could not measure recovery partition free space'
runtime_bytes=$(/usr/bin/du --summarize --block-size=1 -- /usr/lib/cubelinux-recovery/recovery-ui \
    /usr/lib/cubelinux-recovery/qml /usr/lib/cubelinux-recovery/runtime | \
    /usr/bin/awk '{ total += $1 } END { print total+0 }')
required_bytes=$((bundle_bytes + runtime_bytes + minimum_free_bytes))
(( available_bytes >= required_bytes )) ||
    fail "recovery partition is too small (need ${required_bytes} bytes; have ${available_bytes})"

slot="$recovery_mount/slots/A"
/usr/bin/install -d -m 0755 "$slot/LiveOS" "$slot/boot" "$recovery_mount/slots/B"
/usr/bin/cp --reflink=auto -- "$live_media_root/LiveOS/squashfs.img" "$slot/LiveOS/squashfs.img"
/usr/bin/cp --reflink=auto -- "$live_media_root/images/pxeboot/vmlinuz" "$slot/boot/vmlinuz"
/usr/bin/cp --reflink=auto -- "$live_media_root/images/pxeboot/initrd.img" "$slot/boot/initrd.img"

runtime_slot="$recovery_mount/runtime/A"
runtime_root="$runtime_slot/rootfs"
if /usr/bin/find /usr/lib/cubelinux-recovery/qml /usr/lib/cubelinux-recovery/runtime \
    -type l -print -quit | /usr/bin/grep -q .; then
    fail 'recovery runtime component contains a symlink'
fi
/usr/bin/install -d -m 0755 \
    "$runtime_root/usr/local/libexec/cubelinux" \
    "$runtime_root/usr/lib/cubelinux-recovery/qml"
/usr/bin/install -m 0755 /usr/lib/cubelinux-recovery/recovery-ui \
    "$runtime_root/usr/local/libexec/cubelinux/recovery-ui"
while IFS= read -r -d '' source; do
    relative=${source#/usr/lib/cubelinux-recovery/runtime/}
    [[ "$relative" =~ ^[A-Za-z0-9._/-]+$ && "$relative" != *..* ]] ||
        fail "unsafe recovery helper path: $relative"
    /usr/bin/install -D -m 0755 -- "$source" "$runtime_root/usr/local/libexec/cubelinux/$relative"
done < <(/usr/bin/find /usr/lib/cubelinux-recovery/runtime -type f -print0)
while IFS= read -r -d '' source; do
    relative=${source#/usr/lib/cubelinux-recovery/qml/}
    [[ "$relative" =~ ^[A-Za-z0-9._/-]+$ && "$relative" != *..* ]] ||
        fail "unsafe recovery QML path: $relative"
    /usr/bin/install -D -m 0644 -- "$source" "$runtime_root/usr/lib/cubelinux-recovery/qml/$relative"
done < <(/usr/bin/find /usr/lib/cubelinux-recovery/qml -type f -print0)
(
    cd "$runtime_root"
    while IFS= read -r name; do
        /usr/bin/sha256sum -- "$name"
    done < <(/usr/bin/find usr -type f -printf '%P\n' | LC_ALL=C /usr/bin/sort)
) > "$runtime_slot/SHA256SUMS"
(cd "$runtime_root" && /usr/bin/sha256sum --check --strict "$runtime_slot/SHA256SUMS" >/dev/null) ||
    fail 'recovery runtime checksum verification failed'
runtime_manifest_digest=$(/usr/bin/sha256sum "$runtime_slot/SHA256SUMS")
runtime_manifest_digest=${runtime_manifest_digest%% *}
{
    printf 'format=1\n'
    printf 'manifest_sha256=%s\n' "$runtime_manifest_digest"
} > "$runtime_slot/CUBELINUX_RECOVERY_RUNTIME"

/usr/bin/install -m 0644 /usr/share/cubelinux/target-image-ref "$slot/CUBELINUX_IMAGE_REF"
{
    printf 'format=1\n'
    printf 'disk_ptuuid=%s\n' "$disk_ptuuid"
    printf 'root_partuuid=%s\n' "$root_partuuid"
    printf 'recovery_partuuid=%s\n' "$recovery_partuuid"
    printf 'efi_partuuid=%s\n' "$efi_partuuid"
} > "$slot/CUBELINUX_LAYOUT"

(
    cd "$slot"
    /usr/bin/sha256sum \
        LiveOS/squashfs.img \
        boot/vmlinuz \
        boot/initrd.img \
        CUBELINUX_IMAGE_REF \
        CUBELINUX_LAYOUT > SHA256SUMS
)
/usr/local/libexec/cubelinux/verify-recovery-bundle "$slot"
{
    printf 'set recovery_slot=A\n'
    printf 'set recovery_runtime_slot=A\n'
    printf 'linux ($recovery)/slots/A/boot/vmlinuz root=live:PARTUUID=%s ro rd.live.image rd.live.dir=/slots/A/LiveOS rd.live.overlay.overlayfs=1 cubelinux.recovery=1 cubelinux.recovery_slot=A cubelinux.recovery_runtime_slot=A console=tty0\n' "$recovery_partuuid"
    printf 'initrd ($recovery)/slots/A/boot/initrd.img\nboot\n'
} > "$recovery_mount/active.cfg"
/usr/bin/sync --file-system "$recovery_mount"
/usr/bin/umount "$recovery_mount" || fail "could not unmount staged recovery partition $recovery_device"
recovery_mounted=0
echo "Staged the offline factory-reset image and recovery runtime on $recovery_device (${bundle_bytes} byte base image, $(</usr/share/cubelinux/target-image-ref))."
